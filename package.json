{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node .\\tools\\dev.mjs",
    "dev:backend": "tsx server/index.ts",
    "build": "node .\\generate-sitemap.js && node .\\tools\\build-css.mjs && esbuild .\\src\\main.build.tsx --bundle --format=esm --platform=browser --splitting --outdir=dist\\assets --entry-names=main --chunk-names=chunks/[name]-[hash] --asset-names=assets/[name]-[hash] --public-path=/assets --loader:.jpg=file --loader:.jpeg=file --loader:.png=file --loader:.svg=file --loader:.webp=file --loader:.gif=file --loader:.ico=file --loader:.avif=file --define:import.meta.env.VITE_GA4_ID=undefined --define:import.meta.env.VITE_GSC_VERIFICATION=undefined && node .\\tools\\copy-public.mjs && node .\\tools\\write-build-html.mjs",
    "preview": "node .\\tools\\preview.mjs",
    "dev:with-backend": "node tools/dev-with-backend.mjs",
    "clean": "node -e \"const fs=require('fs'); for (const target of ['dist', 'server.js']) fs.rmSync(target, { recursive: true, force: true });\"",
    "audit:colors": "node tools/audit-brand-colors.mjs",
    "audit:typography": "node tools/audit-typography.mjs",
    "lint": "tsc --noEmit",
    "check": "npm run build"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lenis": "^1.3.23",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
