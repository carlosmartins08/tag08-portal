{
  "name": "tag08-portal",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "predev": "node tools/clear-next-dev-cache.mjs",
    "dev": "next dev",
    "prebuild": "npm run db:generate",
    "build": "next build",
    "postbuild": "node tools/prepare-standalone.mjs",
    "start": "node .next/standalone/server.js",
    "preview": "node .next/standalone/server.js",
    "clean": "node -e \"const fs=require('fs'); fs.rmSync('.next', { recursive: true, force: true });\"",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "worker:integrations": "node server/integrationWorker.mjs",
    "worker:retention": "tsx server/retentionWorker.ts",
    "verify:routes": "tsx tools/verify-routes.ts",
    "test:routes": "tsx tests/routeRegistry.test.ts && tsx tests/localePublishing.test.ts && tsx tests/proxy.test.ts",
    "test:contracts": "tsx tests/onboardingContract.test.ts && tsx tests/submissionContracts.test.ts && tsx tests/apiResponse.test.ts",
    "test": "npm run test:routes && npm run test:contracts",
    "audit:colors": "node tools/audit-brand-colors.mjs",
    "audit:typography": "node tools/audit-typography.mjs",
    "lint": "tsc --noEmit",
    "check": "npm test && npm run lint && npm run build"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "dotenv": "^17.2.3",
    "lenis": "^1.3.23",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "next": "^16.2.10",
    "pg": "^8.22.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "postcss": "^8.5.19",
    "prisma": "^7.8.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.23.1",
    "typescript": "~5.8.2"
  }
}
