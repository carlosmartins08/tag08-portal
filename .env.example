# Contêiner GTM, fonte única para GA4, Meta Pixel, Pinterest e LinkedIn.
# Não adicione snippets dessas plataformas diretamente ao aplicativo.
NEXT_PUBLIC_GTM_ID="GTM-NNL7DMP"

# Token de verificacao do Search Console para a homepage.
NEXT_PUBLIC_GSC_VERIFICATION="bC30NfaQSPrDS45AaAbVfCAaLS7OMLPWBBZJC0DoF_I"

# A CSP e aplicada por padrao. Use "true" apenas em staging, temporariamente,
# para diagnosticar uma nova integracao de terceiros antes de libera-la.
CSP_REPORT_ONLY="false"

# Sync oficial do canal do YouTube da TAG08.
YOUTUBE_CHANNEL_HANDLE="@tag08.com.br_sobre"
YOUTUBE_CHANNEL_ID="UCTTbpc8InY35Z9WvinnCwNg"
YOUTUBE_API_KEY="sua_chave_da_google_cloud"

# Sync oficial das avaliacoes do Google Business Profile.
# Use acesso direto temporario OU o fluxo de refresh token abaixo.
GOOGLE_BUSINESS_LOCATION_NAME="accounts/123456789/locations/987654321"
GOOGLE_BUSINESS_ACCESS_TOKEN=""
GOOGLE_BUSINESS_REFRESH_TOKEN=""
GOOGLE_BUSINESS_CLIENT_ID=""
GOOGLE_BUSINESS_CLIENT_SECRET=""

# Persistencia PostgreSQL. Obrigatoria em staging e producao.
DATABASE_URL="postgresql://user:password@host:5432/tag08?schema=public"
DATABASE_SSL="false"

# Desenvolvimento local com Docker. Nunca use esta URL fora da maquina local.
# DATABASE_URL="postgresql://tag08:tag08_local_only@localhost:5432/tag08"

# Origens autorizadas a chamar APIs do navegador, separadas por virgula.
ALLOWED_ORIGINS="https://tag08.com.br,https://www.tag08.com.br"

# Integracoes externas so devem ser habilitadas apos validacao em staging.
INTEGRATIONS_ENABLED="false"
GOOGLE_SHEETS_ENABLED="false"
CLICKUP_ENABLED="false"
INTEGRATION_PROCESSING_LEASE_SECONDS="900"
# Use somente em staging para processar uma entrega especifica sem consumir a fila inteira.
INTEGRATION_DELIVERY_ID=""
# Use somente em staging para testar retencao sobre um registro sintetico especifico.
RETENTION_AGGREGATE_ID=""
GOOGLE_SHEETS_SPREADSHEET_ID="1XXXCv0Zn9grrv1BxPR76H2iIfYQAyfiA6rEUSfNVCQE"
GOOGLE_SERVICE_ACCOUNT_JSON=""
CLICKUP_API_TOKEN=""
CLICKUP_TALENT_LIST_ID="900700474161"
CLICKUP_ONBOARDING_LIST_ID=""

# Protege metricas operacionais e jobs internos.
INTERNAL_API_TOKEN=""
