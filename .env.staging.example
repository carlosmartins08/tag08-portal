# Direct Contact/Talent staging only. Copy to the gitignored .env.staging.local.
# This file is parsed explicitly by the staging preflight/runner; inherited env is ignored.
NODE_ENV="production"
ONBOARDING_ENABLED="false"

# Persistent application delivery remains disabled. The one-shot runner enables
# the direct stores only in its own in-memory process after explicit confirmation.
SUBMISSIONS_ENABLED="false"
INTEGRATIONS_ENABLED="false"
GOOGLE_SHEETS_ENABLED="false"
CLICKUP_ENABLED="false"
INTEGRATION_MOCK_MODE="false"

# Exact staging-only destinations. Contact and Talent share the approved staging
# list; task name and payload identify the flow. Never replace these with production IDs.
GOOGLE_SHEETS_SPREADSHEET_ID="1XXXCv0Zn9grrv1BxPR76H2iIfYQAyfiA6rEUSfNVCQE"
CLICKUP_PRE_SALES_LIST_ID="901327894264"
CLICKUP_TALENT_LIST_ID="901327894264"
CLICKUP_ONBOARDING_LIST_ID=""

# Supply only staging credentials through the operator's protected local file.
GOOGLE_SERVICE_ACCOUNT_JSON=""
CLICKUP_API_TOKEN=""
