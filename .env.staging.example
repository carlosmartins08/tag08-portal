# Contact-only staging template. Copy to .env.staging.local (gitignored).
# Keep the deployed web service and any scheduled worker disabled for integrations.
NODE_ENV="production"
HOSTNAME="0.0.0.0"
PORT="3000"
BASE_URL=""
ALLOWED_ORIGINS=""
ONBOARDING_ENABLED="false"

# Dedicated staging database only. Set host/database from an independent provider check;
# the URL must include sslmode=verify-full and match both identity fields exactly.
DATABASE_URL=""
DATABASE_SSL="true"
TAG08_STAGING_DATABASE_HOST=""
TAG08_STAGING_DATABASE_NAME=""
# Set true only after independently confirming this exact host/database in the staging provider.
TAG08_STAGING_DATABASE_APPROVED="false"

# Keep every persistent integration flag disabled. The one-delivery runner
# enables one target only in its child process after explicit authorization.
INTEGRATIONS_ENABLED="false"
GOOGLE_SHEETS_ENABLED="false"
CLICKUP_ENABLED="false"
INTEGRATION_MOCK_MODE="false"
INTEGRATION_PROCESSING_LEASE_SECONDS="900"
INTEGRATION_DELIVERY_ID=""

# Exact existing staging destinations; do not replace with production IDs.
GOOGLE_SHEETS_SPREADSHEET_ID="1XXXCv0Zn9grrv1BxPR76H2iIfYQAyfiA6rEUSfNVCQE"
CLICKUP_PRE_SALES_LIST_ID="901327894264"

# Secrets are supplied by the staging secret manager/operator, never committed.
GOOGLE_SERVICE_ACCOUNT_JSON=""
CLICKUP_API_TOKEN=""

# Contact-only scope: no other CRM list may be configured in this environment.
CLICKUP_TALENT_LIST_ID=""
CLICKUP_ONBOARDING_LIST_ID=""
