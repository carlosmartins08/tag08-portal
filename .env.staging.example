# Copy these names to the staging environment in the hosting panel. Do not upload this file with real values.
NODE_ENV="production"
HOSTNAME="0.0.0.0"
PORT="3000"

# Remote PostgreSQL dedicated to staging. Never point this URL at local Docker or production.
DATABASE_URL="postgresql://tag08_staging:replace_me@staging-postgres.example:5432/tag08_staging?schema=public"
DATABASE_SSL="true"

# Public staging origin and internal-only operational access.
ALLOWED_ORIGINS="https://staging.tag08.com.br"
INTERNAL_API_TOKEN="replace_with_a_long_random_secret"
BASE_URL="https://staging.tag08.com.br"

# Mantenha false apos validar as integracoes permitidas. true e uma excecao
# temporaria para diagnostico de uma nova origem de terceiro.
CSP_REPORT_ONLY="false"

# External deliveries remain disabled until the synthetic staging gate is approved.
INTEGRATIONS_ENABLED="false"
GOOGLE_SHEETS_ENABLED="false"
CLICKUP_ENABLED="false"
INTEGRATION_PROCESSING_LEASE_SECONDS="900"
INTEGRATION_DELIVERY_ID=""
RETENTION_AGGREGATE_ID=""

# Optional public measurement and official-content sync. Empty values keep safe local fallbacks.
NEXT_PUBLIC_GTM_ID="GTM-NNL7DMP"
NEXT_PUBLIC_GSC_VERIFICATION=""
YOUTUBE_CHANNEL_HANDLE="@tag08.com.br_sobre"
YOUTUBE_CHANNEL_ID="UCTTbpc8InY35Z9WvinnCwNg"
YOUTUBE_API_KEY=""
GOOGLE_BUSINESS_LOCATION_NAME=""
GOOGLE_BUSINESS_ACCESS_TOKEN=""
GOOGLE_BUSINESS_REFRESH_TOKEN=""
GOOGLE_BUSINESS_CLIENT_ID=""
GOOGLE_BUSINESS_CLIENT_SECRET=""

# Reserved for the controlled integration phase. Keep empty while integrations are disabled.
GOOGLE_SHEETS_SPREADSHEET_ID=""
GOOGLE_SERVICE_ACCOUNT_JSON=""
CLICKUP_API_TOKEN=""
CLICKUP_TALENT_LIST_ID="900700474161"
CLICKUP_ONBOARDING_LIST_ID=""
